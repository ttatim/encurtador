Options -Indexes -MultiViews
DirectoryIndex index.php
<FilesMatch "^(\.env.*|\.gitignore|README\.md|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:config|includes|database|scripts|tests|conexao)(?:/|$) - [F,L,NC]
RewriteRule ^p/([A-Za-z0-9][A-Za-z0-9_-]{2,49})/?$ preview.php?link=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9][A-Za-z0-9_-]{2,49})/?$ redirect.php?link=$1 [L,QSA]
